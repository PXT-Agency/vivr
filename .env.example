# Public application URL (optional locally, required in production).
# Used as the canonical base URL for links and SEO.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (secret). Required for any database operation,
# including migrations. The app can still boot and serve /api/health without it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vivr

# Clerk authentication (Phase 2). Leave empty until real credentials exist.
# Populate from the Clerk dashboard or `npx clerk@latest env pull`; never commit values.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=